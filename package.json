{
  "name": "fisiologia-interativa-visual-tests",
  "private": true,
  "scripts": {
    "dev": "pnpm --dir endocrino/origem-v0 dev",
    "start:tutor": "node --env-file-if-exists=server/.env server/tutor.cjs",
    "test:tutor": "node --test tests/tutor/server.test.cjs",
    "test:tutor:browser": "playwright test --config=tests/tutor/playwright.config.cjs",
    "test:visual": "playwright test",
    "test:intencao": "playwright test tests/visual/da-intencao-ao-movimento.spec.js",
    "test:ra": "npm --prefix ra test",
    "build:biofeedback": "node scripts/build-biofeedback.cjs",
    "test:biofeedback": "node --test tests/biofeedback-audio.test.cjs tests/biofeedback-session.test.cjs tests/biofeedback-agenda.test.cjs tests/biofeedback-offline.test.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
