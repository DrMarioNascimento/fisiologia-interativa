.tutor-launcher.tutor-coin{background:transparent;box-shadow:none;filter:drop-shadow(0 5px 5px #102f3155)}
.tutor-coin .tutor-portrait{inset:0;overflow:visible;background:transparent;pointer-events:none}
.tutor-coin .tutor-coin-poster{width:100%;height:100%;left:0;top:0;transform:rotate(180deg);border-radius:50%;object-fit:contain;user-select:none}
.tutor-coin-canvas{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.tutor-coin.coin-ready .tutor-coin-poster{visibility:hidden}
.tutor-coin:not(.coin-ready) .tutor-coin-canvas{visibility:hidden}
.tutor-launcher.tutor-coin:focus-visible{outline:3px solid #47a98f;outline-offset:4px}
.tutor-coin .tutor-badge{bottom:0;right:0}
.tutor-coin-sound{border:1px solid #ffffff60;border-radius:14px;background:transparent;color:inherit;font:inherit;font-size:11px;line-height:1.25;padding:5px 7px;cursor:pointer;white-space:nowrap}
.tutor-coin-sound:focus-visible{outline:2px solid currentColor;outline-offset:2px}
@media(max-width:420px){.tutor-coin-sound{font-size:10px;padding:4px}.tutor-head{gap:6px}}
