  if(mid){S.running=true;}else{if(S.trials.length>=8)return;S.cur=buildTrial();S.tCur=0;S.running=true;}
  updateButtons();}
function finishTrial(){const c=S.cur;if(!c||S.trials.includes(c))return;decimate(c);S.trials.push(c);renderResults();updateButtons();}
