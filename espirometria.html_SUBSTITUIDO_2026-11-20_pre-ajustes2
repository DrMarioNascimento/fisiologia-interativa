<script>(() => {
'use strict';
const $=id=>document.getElementById(id);
/* ===== Motor: modelo mecânico de um compartimento com limitação ao fluxo ===== */
const clamp=(x,a,b)=>Math.max(a,Math.min(b,x));
const DT=0.0025,TMAX_EXP=15,A_OBS=.8,C_OBS=12,BETA=2.0,BW=.25;
function adultPred(sex,age,h){
  const M=sex==='M',ln=Math.log;
  const fvc=M?.0517*h-.0207*age-3.18:.0441*h-.0189*age-2.848;
  const fev1=M?.0338*h-.0252*age-.789:.0314*h-.0203*age-1.353;
  const ratio=M?-.175*h-.197*age+120.3:-.140*h-.158*age+111.5;
  const pef=Math.exp(M?.830*ln(h)-.114*ln(age)-1.43:1.442*ln(h)-.125*ln(age)-4.863);
  const fef=Math.exp(M?3.93-.687*ln(age):.998*ln(h)-.588*ln(age)-1.852);
  return {fvc,fev1,ratio,pef,fef,lln:{fvc:fvc-(M?.90:.64),fev1:fev1-(M?.76:.61),ratio:ratio-(M?7.6:8.5),pef:pef*(M?.76:.75),fef:fef*(M?.59:.57)}};
}
/* Crianças de 3 a 12 anos: equações de Jones et al. 2020 (percentil 50, crianças brancas); LLN e PFE aproximados */
function kidPred(sex,age,h){
  const M=sex==='M',a=clamp(age,3,12.9),lh=Math.log(clamp(h,85,176)),la=Math.log(a);
  const c=M?{fvc:[-11.358191,2.419817,.115477],fev1:[-10.434226,2.207609,.114001],fef:[-6.957857,1.527303,.138649],rl:[1.942780,-.231255]}
           :{fvc:[-10.741935,2.261976,.156836],fev1:[-9.967740,2.088950,.150386],fef:[-7.385469,1.594033,.203576],rl:[1.313149,-.100805]};
  const ev=k=>Math.exp(c[k][0]+c[k][1]*lh+c[k][2]*la),fvc=ev('fvc'),fev1=ev('fev1'),fef=ev('fef'),pef=2.75*fev1;
  return {fvc,fev1,ratio:100*fev1/fvc,pef,fef,lln:{fvc:.8*fvc,fev1:.78*fev1,ratio:100*(c.rl[0]+c.rl[1]*lh),pef:.75*pef,fef:.6*fef}};
}
function predicted(sex,age,h){
  if(age>=20)return adultPred(sex,age,h);
  if(age<=12)return kidPred(sex,age,h);
  const w=(age-12)/8,A=adultPred(sex,20,h),K=kidPred(sex,12,h),mx=(k,b)=>b*w+k*(1-w),o={lln:{}};
  ['fvc','fev1','ratio','pef','fef'].forEach(k=>{o[k]=mx(K[k],A[k]);o.lln[k]=mx(K.lln[k],A.lln[k]);});return o;
}
function forcedExp(p){
  const {x0,tau0,obs,res,eff}=p,emax=.45+.55*eff,te=.035+(1-eff)*.22;
  const tauOf=x=>{const u=1-x/x0;return tau0*(1+A_OBS*obs)*(1+C_OBS*obs*u*u)*(1-.35*res);};
  const out={t:[0],v:[0],f:[0]};let x=x0,t=0,lowT=0;
  while(t<TMAX_EXP){
    const u=1-x/x0,ramp=1-Math.exp(-t/te),edep=ramp*(1-(1-emax)*Math.pow(x/x0,2))*(1+BETA*(1-.5*obs)*Math.exp(-u/BW));
    const f=Math.max(0,edep*x/tauOf(x));
    x-=f*DT;if(x<0)x=0;t+=DT;out.t.push(t);out.v.push(x0-x);out.f.push(f);
    if(f<.025){lowT+=DT;if(lowT>=1&&t>1.5)break;}else lowT=0;
  }
  return out;
}
function metrics(c){
  const n=c.t.length,w=Math.round(.08/DT);let best=-1,bi=0;
  for(let i=0;i+w<n;i++){const s=(c.v[i+w]-c.v[i])/(w*DT);if(s>best){best=s;bi=i;}}
  const t0=Math.max(0,c.t[bi]-c.v[bi]/best);
  const vAt=tt=>{const k=tt/DT,i=Math.floor(k);if(i>=n-1)return c.v[n-1];return c.v[i]+(k-i)*(c.v[i+1]-c.v[i]);};
  const ev=vAt(t0),tend=c.t[n-1],fvc=c.v[n-1]-ev,fev1=(t0+1<=tend)?vAt(t0+1)-ev:fvc;
  let pef=0,ip=0;for(let i=0;i<n;i++)if(c.f[i]>pef){pef=c.f[i];ip=i;}
  const tAtV=vv=>{for(let i=0;i<n;i++)if(c.v[i]-ev>=vv)return c.t[i];return tend;};
  const fAtV=fr=>{const vv=fr*fvc+ev;for(let i=0;i<n;i++)if(c.v[i]>=vv)return c.f[i];return 0;};
  const t25=tAtV(.25*fvc),t50=tAtV(.5*fvc),t75=tAtV(.75*fvc);
  const lastSec=vAt(tend)-vAt(Math.max(0,tend-1));
  return {t0,ev,fvc,fev1,ratio:100*fev1/fvc,pef,tpef:c.t[ip],fef2575:.5*fvc/Math.max(.001,t75-t25),fef25:fAtV(.25),fef50:fAtV(.5),fef75:fAtV(.75),texp:tend-t0,tend,plateau:lastSec<.025,t25,t50,t75,evPct:100*ev/fvc,slope:best,tslope:c.t[bi],vslope:c.v[bi]};
}
function calibrateTau0(sex,age,h){
  const P=predicted(sex,age,h),target=P.fev1/P.fvc;let lo=.1,hi=3;
  for(let k=0;k<36;k++){const mid=(lo+hi)/2,m=metrics(forcedExp({x0:P.fvc,tau0:mid,obs:0,res:0,eff:1}));if(m.fev1/m.fvc>target)lo=mid;else hi=mid;}
  return (lo+hi)/2;
}
/* ===== Estado ===== */
const profiles=[
 {g:'crianca',id:'c-normal',t:'Criança saudável',sex:'M',age:8,h:130,obs:0,res:0,eff:100,bd:0,info:'Sem doença: na infância a relação VEF₁/CVF é alta (cerca de 90%) e os volumes crescem com a altura.'},
 {g:'crianca',id:'c-asma',t:'Asma na infância (reversível)',sex:'F',age:7,h:122,obs:20,res:0,eff:100,bd:90,info:'Obstrução leve a moderada, típica da asma, com boa resposta ao broncodilatador.'},
 {g:'crianca',id:'c-fc',t:'Fibrose cística',sex:'M',age:10,h:135,obs:45,res:10,eff:100,bd:30,info:'Muco espesso e inflamação crônica: obstrução progressiva, com resposta variável ao broncodilatador.'},
