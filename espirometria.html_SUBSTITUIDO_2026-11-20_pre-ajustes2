  [['t25','25%',m.fef25],['t50','50%',m.fef50],['t75','75%',m.fef75]].forEach(([k,lb,f])=>{if(el>=m[k]&&el<=c.c.t[c.c.t.length-1])dot(g,A.X(xAt(m[k])),A.Y(fAt(m[k])),V.fef,lb,10,-12);});
}
/* ===== Painéis ===== */
const LAB={fvc:'CVF',fev1:'VEF₁',ratio:'VEF₁/CVF',pef:'PFE',fef:'FEF₂₅₋₇₅%'},UN={fvc:'L',fev1:'L',ratio:'%',pef:'L/s',fef:'L/s'};
const rows=[['fvc','CVF (L)',2,'fvc'],['fev1','VEF₁ (L)',2,'fev1'],['ratio','VEF₁/CVF (%)',1,'ratio'],['pef','PFE (L/s)',1,'pef'],['fef','FEF₂₅₋₇₅% (L/s)',2,'fef']];
function revealed(c){const el=S.tCur-c.tl.tF,m=c.m,fin=S.tCur>=c.tl.tE-1e-6;
  return {fvc:fin,fev1:el>=m.t0+1||fin,ratio:fin,pef:el>=m.tpef,fef:fin};}
function valOf(m,k){return k==='fef'?m.fef2575:m[k];}
function buildResultCards(){$('results').innerHTML=rows.map(([k])=>`<div class="metric" id="m_${k}" style="--metric-strong:${V[k]};--metric-color:${V[k]}3d"><small>${LAB[k]}</small><strong id="mv_${k}">…</strong><em id="ms_${k}"></em></div>`).join('');}
function updateCapture(){const c=S.cur,P=P0(),R=c?revealed(c):{};
  rows.forEach(([k,lb,d])=>{const has=c&&R[k],v=has?valOf(c.m,k):NaN,low=has&&v<P.lln[k];
    $('m_'+k).classList.toggle('flag',!!low);
    $('mv_'+k).innerHTML=has?fmt(v,d)+'<i>'+UN[k]+'</i>':'…';
    $('ms_'+k).innerHTML=has?fmt(100*v/P[k],0)+'% do previsto ('+fmt(P[k],d)+')'+(low?' · <b>abaixo do LLN</b>':''):'previsto '+fmt(P[k],d)+' · LLN '+fmt(P.lln[k],d);});
  let q='Realize uma manobra para capturar os valores.';
  if(c&&S.tCur>=c.tl.tE-1e-6){q=`<b class="${c.accept?'ok':'no'}">${c.accept?'Manobra aceitável':'Manobra não aceitável'}</b> · início: volume extrapolado ${fmt(c.m.ev*1000,0)} mL (${fmt(c.m.evPct,1)}% da CVF) ${c.startOk?'✓':'✗'} · expiração: ${fmt(c.m.texp,1)} s, platô ${c.m.plateau?'sim':'não'} ${c.expOk?'✓':'✗'}${c.reasons.length?' · '+c.reasons.join('; '):''}`;}
  else if(c)q='Capturando valores durante a manobra…';
  $('capQuality').innerHTML=q;}
function updateSensors(){const c=S.cur,ph=phaseNow();$('sPhase').textContent=PH[ph];
  if(!c){$('sTime').innerHTML='0,00<i>s</i>';$('sVol').innerHTML='0,00<i>L</i>';$('sFlow').innerHTML='0,00<i>L/s</i>';return;}
  const i=Math.min(c.tl.L.length-1,Math.floor(S.tCur/DT));
  $('sTime').innerHTML=fmt(ph>=3?Math.max(0,S.tCur-c.tl.tF):S.tCur)+'<i>s</i>';
  $('sVol').innerHTML=fmt(c.tl.frc-c.tl.L[i])+'<i>L</i>';$('sFlow').innerHTML=fmt(c.tl.Q[i])+'<i>L/s</i>';}
const COACH=['Pressione <b>Realizar manobra</b>. O paciente respira normalmente, enche o pulmão ao máximo e depois sopra o mais forte e rápido possível, até esvaziar.',
 'O volume corrente oscila ao redor da capacidade residual funcional (CRF). O sensor registra volume e fluxo a cada instante.',
 'Inspiração máxima até a capacidade pulmonar total (CPT). Com o pulmão cheio, a expiração forçada pode começar — a pausa deve ser curta (menos de 1 s).',
 '“SOPRE FORTE E RÁPIDO!” O fluxo sobe até o pico (PFE) em cerca de 0,1 s e depois cai à medida que o pulmão esvazia: essa queda é limitada pela mecânica das vias aéreas, não pelo esforço.',
 'Inspiração forçada: fecha a alça fluxo–volume e mostra a parte inspiratória, que depende mais do esforço.',
 'Manobra concluída. Os valores foram capturados; veja a qualidade abaixo e os resultados do exame.'];
function updateStages(){const ph=phaseNow();document.querySelectorAll('.stage').forEach(el=>{const k=+el.dataset.st;el.classList.toggle('on',ph===k);el.classList.toggle('done',ph>k||ph===5);});$('coach').innerHTML=COACH[ph];}
function accOf(phase){return S.trials.filter(t=>t.phase===phase&&t.accept);}
function best(phase){const a=accOf(phase);if(!a.length)return null;
  const fvc=Math.max(...a.map(t=>t.m.fvc)),fev1=Math.max(...a.map(t=>t.m.fev1)),pef=Math.max(...a.map(t=>t.m.pef)),bt=a.reduce((p,t)=>t.m.fvc+t.m.fev1>p.m.fvc+p.m.fev1?t:p);
  return {fvc,fev1,ratio:100*fev1/fvc,pef,fef:bt.m.fef2575,n:a.length};}
function repro(phase){const a=accOf(phase);if(a.length<2)return null;const top=k=>a.map(t=>t.m[k]).sort((x,y)=>y-x),f=top('fvc'),e=top('fev1'),lim=f[0]<=1?.1:.15;
  const df=f[0]-f[1],de=e[0]-e[1];return {df,de,ok:df<=lim&&de<=lim,lim};}
function updateRelations(){const L=S.trials.filter(t=>t.phase===S.phase),t=L[L.length-1],P=P0();
  if(!t){['fRatio','fFef','fPef','fBd'].forEach(id=>$(id).textContent='Realize uma manobra para ver os valores.');}
  else{const m=t.m;
    $('fRatio').innerHTML=`${fmt(m.fev1)} ÷ ${fmt(m.fvc)} × 100 = <b>${fmt(m.ratio,1)}%</b> (limite inferior ${fmt(P.lln.ratio,1)}%) → ${m.ratio<P.lln.ratio?'abaixo do limite: padrão obstrutivo':'dentro do esperado'}.`;
    $('fFef').innerHTML=`0,5 × ${fmt(m.fvc)} ÷ (${fmt(m.t75-m.t0)} − ${fmt(m.t25-m.t0)}) = <b>${fmt(m.fef2575)} L/s</b> (previsto ${fmt(P.fef)}).`;
    $('fPef').innerHTML=`Pico de <b>${fmt(m.pef,1)} L/s</b> aos ${fmt((m.tpef-m.t0)*1000,0)} ms (previsto ${fmt(P.pef,1)}).`;}
  const B=best('pre'),Q=best('post');
  if(B&&Q){const dF=Q.fev1-B.fev1,pF=100*dF/B.fev1;$('fBd').innerHTML=`${fmt(Q.fev1)} − ${fmt(B.fev1)} = <b>${dF>=0?'+':''}${fmt(dF*1000,0)} mL (${pF>=0?'+':''}${fmt(pF,0)}%)</b> → resposta ${dF>=.2&&pF>=12?'significativa (≥ 12% e ≥ 200 mL)':'não significativa'}.`;}
  else $('fBd').textContent=B?'Administre o broncodilatador e repita as manobras para calcular a variação.':'Faça as manobras pré-broncodilatador primeiro.';}
function renderResults(){updateRelations();
  const tr=S.trials;$('trialCount').textContent=tr.length+(tr.length===1?' manobra':' manobras');
  $('trials').innerHTML=tr.length?tr.map((t,i)=>`<div class="trial ${t.accept?'ok':'no'}"><b>Manobra ${i+1}</b> · ${t.phase==='post'?'pós-BD':'pré-BD'}<br>CVF ${fmt(t.m.fvc)} L · VEF₁ ${fmt(t.m.fev1)} L<br>${t.accept?'<span style="color:#1f6b4a;font-weight:700">Aceitável</span>':'<span style="color:#b3261e;font-weight:700">Não aceitável</span>: '+t.reasons.join('; ')}</div>`).join(''):'<p class="muted">Nenhuma manobra realizada ainda.</p>';
  const ph=S.phase==='post'?'post':'pre',r=repro(ph),a=accOf(ph);
  $('repro').textContent=!tr.length?'':a.length<2?`São necessárias ao menos 3 manobras aceitáveis, duas reprodutíveis (${a.length} aceitável${a.length===1?'':'is'} nesta fase).`:`Reprodutibilidade: diferença de ${fmt(r.df*1000,0)} mL na CVF e ${fmt(r.de*1000,0)} mL no VEF₁ entre as duas maiores — ${r.ok?'reprodutível ✓':'acima de '+fmt(r.lim*1000,0)+' mL ✗'}.${a.length<3?' Faltam manobras aceitáveis para completar o exame (mínimo 3).':''}`;
  const P=P0(),B=best('pre'),Q=best('post');
  if(!B){$('summary').innerHTML='';$('verdict').innerHTML='';return;}
  const head=`<thead><tr><th>Parâmetro</th><th>Previsto</th><th>Limite inf.</th><th>Pré-BD</th><th>% prev.</th>${Q?'<th>Pós-BD</th><th>% prev.</th><th>Variação</th>':''}</tr></thead>`;
  const body=rows.map(([k,lb,d])=>{const v=B[k],low=v<P.lln[k];let post='';
    if(Q){const q=Q[k],dl=q-v,dp=100*dl/v;post=`<td class="${q<P.lln[k]?'low':'ok'}">${fmt(q,d)}</td><td>${fmt(100*q/P[k],0)}%</td><td>${dl>=0?'+':''}${fmt(k==='ratio'?dl:dl*(k==='fvc'||k==='fev1'?1000:1),k==='ratio'?1:(k==='fvc'||k==='fev1'?0:d))}${k==='fvc'||k==='fev1'?' mL':''}${k==='ratio'?' pp':''} (${dp>=0?'+':''}${fmt(dp,0)}%)</td>`;}
    return `<tr><td><span class="dot" style="background:${V[k]}"></span>${lb}</td><td>${fmt(P[k],d)}</td><td>${fmt(P.lln[k],d)}</td><td class="${low?'low':'ok'}">${fmt(v,d)}</td><td>${fmt(100*v/P[k],0)}%</td>${post}</tr>`;}).join('');
  $('summary').innerHTML=head+'<tbody>'+body+'</tbody>';
  // interpretação (valores pré-BD)
  const ratioLow=B.ratio<P.lln.ratio,fvcLow=B.fvc<P.lln.fvc,pf=100*B.fev1/P.fev1;let pattern,sev='';
  if(!ratioLow&&!fvcLow)pattern=B.fev1<P.lln.fev1?'VEF₁ abaixo do limite inferior com relação VEF₁/CVF e CVF normais: achado isolado, a correlacionar com o quadro clínico.':'Espirometria dentro dos limites da normalidade.';
  else if(!ratioLow&&fvcLow)pattern='Padrão sugestivo de restrição: CVF reduzida com relação VEF₁/CVF preservada. Para confirmar, é preciso medir a capacidade pulmonar total (pletismografia ou diluição de gases). Uma CVF baixa também pode resultar de esforço ou expiração insuficientes.';
  else if(ratioLow&&!fvcLow)pattern='Distúrbio ventilatório obstrutivo: relação VEF₁/CVF abaixo do limite inferior da normalidade.';
  else pattern='Obstrução com CVF reduzida: pode representar aprisionamento de ar ou distúrbio misto. Confirmar com a capacidade pulmonar total.';
  if(ratioLow||fvcLow)sev=` Gravidade pelo VEF₁ (${fmt(pf,0)}% do previsto): ${pf>=70?'leve':pf>=60?'moderada':pf>=50?'moderadamente grave':pf>=35?'grave':'muito grave'} (critério ATS/ERS 2005).`;
  let bdTxt='';
  if(Q){const dF=Q.fev1-B.fev1,dC=Q.fvc-B.fvc,pF=100*dF/B.fev1,pC=100*dC/B.fvc,sig=(dF>=.2&&pF>=12)||(dC>=.2&&pC>=12);
    bdTxt=`<br><br><b>Prova broncodilatadora:</b> VEF₁ ${dF>=0?'+':''}${fmt(dF*1000,0)} mL (${pF>=0?'+':''}${fmt(pF,0)}%) e CVF ${dC>=0?'+':''}${fmt(dC*1000,0)} mL (${pC>=0?'+':''}${fmt(pC,0)}%). ${sig?'Resposta significativa (aumento ≥ 12% e ≥ 200 mL).':'Sem resposta significativa pelo critério de aumento ≥ 12% e ≥ 200 mL.'}`;}
  const ok=a.length>=3&&(r&&r.ok);
  $('verdict').innerHTML=`<div class="verdict${ratioLow||fvcLow?' alert':''}"><h3>Interpretação (modelo didático)</h3>${pattern}${sev}${bdTxt}<br><br><span style="color:#647b91;font-size:.84rem">${ok?'Exame com qualidade adequada (3 manobras aceitáveis e reprodutíveis).':'Exame ainda sem os critérios completos de qualidade: a interpretação é provisória.'} A interpretação real depende do quadro clínico e de outros exames.</span></div>`;
}
function setFill(el){el.style.setProperty('--p',((el.value-el.min)/(el.max-el.min)*100)+'%');}
function updatePatientUI(){
  document.querySelectorAll('[data-sex]').forEach(b=>{const on=b.dataset.sex===S.sex;b.classList.toggle('on',on);b.setAttribute('aria-pressed',String(on));});
