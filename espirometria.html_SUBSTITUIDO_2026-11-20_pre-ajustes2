document.querySelectorAll('[data-sex]').forEach(b=>b.addEventListener('click',()=>{S.sex=b.dataset.sex;S.profile='custom';patientChanged();refresh();}));
let pend=false;function later(){if(pend)return;pend=true;requestAnimationFrame(()=>{pend=false;refresh();});}
[['age',v=>{S.age=v;}],['height',v=>{S.h=v;}],['obs',v=>{S.obs=v/100;}],['res',v=>{S.res=v/100;}],['eff',v=>{S.eff=v/100;}],['bd',v=>{S.bd=v/100;}]].forEach(([id,fn])=>$(id).addEventListener('input',e=>{fn(Number(e.target.value));S.profile='custom';patientChanged();later();}));
Object.keys(GRP).forEach(g=>{const box=document.createElement('div');box.className='pg';box.innerHTML=`<h4>${GRP[g].toUpperCase()}</h4><div class="pgrid"></div>`;
