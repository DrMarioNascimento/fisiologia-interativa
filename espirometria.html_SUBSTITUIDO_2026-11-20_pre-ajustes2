/* ===== Ações ===== */
function sigKey(){return `${S.sex}|${S.age}|${S.h}|${S.obs}|${S.res}`;}
let lastSig=sigKey();
function patientChanged(){const k=sigKey();if(k===lastSig)return;lastSig=k;S.auto=0;S.trials=[];S.cur=null;S.running=false;S.tCur=0;S.phase='pre';}
